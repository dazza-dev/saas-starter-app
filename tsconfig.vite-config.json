{
    "extends": "@vue/tsconfig/tsconfig.json",
    "include": ["vite.config.*"],
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "noEmitOnError": false,
        "types": ["node"]
    }
}
