{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "compilerOptions": {
        "verbatimModuleSyntax": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "allowJs": true,
        "skipLibCheck": true,
        "noEmitOnError": false
    }
}
